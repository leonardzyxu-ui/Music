.DS_Store

# SwiftPM / Xcode build products
.build/
DerivedData/
dist/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Codex/local runtime state
.codex/
.playwright-cli/

# Python caches
__pycache__/
*.py[cod]
.venv/
venv/

# Generated YouTube helper payloads. Recreate with script/install_youtube_tools.sh.
Tools/python/
Tools/bin/
Tools/*.whl

# Local music library references and media should never enter the source repo.
SharedMP3Library
*.mp3
*.m4a
*.aac
*.wav
*.flac

# Local visual QA captures can contain desktop context; keep them local.
/screenshots/
website/source-pictures/
website/qa/
website/downloads/
website/updates/
website/appcast.xml

# Logs and temporary files
*.log
*.tmp
